{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cardtastic-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8094"
      ],
      "port": 8094,
      "autoPort": true
    },
    {
      "name": "cardtastic-dev-client",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8093"
      ],
      "port": 8093
    },
    {
      "name": "cardtastic-web-local-server",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_ONLINE_URL=http://localhost:4100",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8095"
      ],
      "port": 8095
    }
  ]
}